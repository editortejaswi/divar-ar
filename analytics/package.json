{
  "name": "divar-analytics",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "wrangler dev --local --persist-to .wrangler-local --port 8787",
    "schema:local": "wrangler d1 execute DB --local --persist-to .wrangler-local --file schema.sql",
    "schema:remote": "wrangler d1 execute DB --remote --file schema.sql",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.125.0"
  }
}
